# Copy to .env
# This machine routes OpenAI-compatible calls through an internal gateway,
# registered in ~/.pi/agent/models.json as the "codex" provider (model gpt-5.5).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://omni-us.ansybot.com/v1
# pi as node script (Windows: never call pi.cmd — cmd.exe mangles multiline argv)
PI_PATH=node C:/nvm4w/nodejs/node_modules/@earendil-works/pi-coding-agent/dist/cli.js
